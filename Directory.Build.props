<Project>
  <!-- One version for the client and the server: xmake.lua and the UI package.json repeat it. -->
  <PropertyGroup>
    <Version>1.2.0</Version>
  </PropertyGroup>
  <!-- One FSharp.Core for every F# project, whatever SDK builds it. Left implicit, it
       follows the SDK band: the 10.0.1xx SDK that Linux distributions ship picks 10.0.x,
       below what SqlHydra.Query needs, while a 10.0.4xx SDK picks 10.1.401. -->
  <PropertyGroup Condition="'$(MSBuildProjectExtension)' == '.fsproj'">
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
  </PropertyGroup>
  <ItemGroup Condition="'$(MSBuildProjectExtension)' == '.fsproj'">
    <PackageReference Include="FSharp.Core" Version="10.1.401" />
  </ItemGroup>
</Project>
