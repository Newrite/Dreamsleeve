<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Generated/AccountSchema.fs">
      <Visible>False</Visible>
    </Compile>
    <Compile Include="SqliteDatabase.fs" />
    <Compile Include="SqliteStatements.fs" />
    <Compile Include="Secrets.fs" />
    <Compile Include="SqliteAccountStore.fs" />
    <Compile Include="SqliteGroundMarkStore.fs" />
    <Compile Include="SqliteAdminStore.fs" />
    <Compile Include="SqliteSanctionStore.fs" />
    <Compile Include="SqliteAddressStore.fs" />
    <Compile Include="SqliteDeviceStore.fs" />
    <Compile Include="AuthService.fs" />
    <Compile Include="AdminService.fs" />
    <Compile Include="TransportOwner.fs" />
    <Compile Include="EnetTransport.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Dreamsleeve.Server.Core/Dreamsleeve.Server.Core.fsproj" />
    <ProjectReference Include="../Dreamsleeve.Server.Infrastructure.Interop/Dreamsleeve.Server.Infrastructure.Interop.csproj" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="SqlHydra.Query" Version="5.0.0" />
    <PackageReference Include="Migrondi.Core" Version="1.3.0" />
    <PackageReference Include="Microsoft.Extensions.Identity.Core" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../../db/migrations/*.sql" Link="db/migrations/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
