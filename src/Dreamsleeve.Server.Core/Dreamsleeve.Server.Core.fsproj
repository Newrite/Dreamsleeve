<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <WarningsAsErrors>$(WarningsAsErrors);FS0025</WarningsAsErrors>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Config.fs" />
        <Compile Include="RuntimeMetrics.fs" />
        <Compile Include="Protocol/ProtocolTypes.fs" />
        <Compile Include="Protocol/PlayerCodec.fs" />
        <Compile Include="Protocol/ChatCodec.fs" />
        <Compile Include="Protocol/SessionCodec.fs" />
        <Compile Include="Protocol/ProtocolCodec.fs" />
        <Compile Include="Authentication.fs" />
        <Compile Include="SessionContracts.fs" />
        <Compile Include="ChatRoomAgent.fs" />
        <Compile Include="SpatialIndex.fs" />
        <Compile Include="PresenceAgent.fs" />
        <Compile Include="PlayerSession.fs" />
        <Compile Include="SessionTable.fs" />
        <Compile Include="ServerRuntime.fs" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../Dreamsleeve.Agent/Dreamsleeve.Agent.fsproj" />
        <ProjectReference Include="../Dreamsleeve.Server.Domain/Dreamsleeve.Server.Domain.fsproj" />
        <ProjectReference Include="../Dreamsleeve.Protocol.Dotnet/Dreamsleeve.Protocol.Dotnet.csproj" />
        <PackageReference Include="yENet" Version="1.2.1" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    </ItemGroup>

</Project>
